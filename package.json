    "typecheck": "tsc --noEmit",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tauri-apps/cli": "^2.12.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.1.0"
  }
}
